rules_version = '2';

// Katso selitys firestore.rules-tiedostosta - sama periaate koskee kuvia:
// ilman kirjautumista pääsyä ei voida rajata käyttäjäkohtaisesti, joten
// alla oleva sääntö on tarkoitettu vain henkilökohtaiseen prototyyppaukseen.
// Kun lisäät Firebase Authin, vaihda esim. muotoon:
//   allow read: if true;
//   allow write: if request.auth != null;

service firebase.storage {
  match /b/{bucket}/o {
    match /structures/{structureId}/items/{itemId}/{fileName} {
      allow read, write: if true;
    }
  }
}
