# Kopioi tämä tiedosto nimelle .env ja täytä arvot omasta Firebase-projektistasi.
# Firebase-konsoli -> Project settings -> General -> "Your apps" -> Web app -> SDK setup and configuration.
# .env ei ole gitissä (katso .gitignore) - älä committoi omia arvojasi.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Valinnainen: kevyt kiinteä salasanakysely etusivulla (ei oikeaa tietoturvaa,
# ks. src/components/PasswordGate.tsx). Jätä tyhjäksi jos et halua sitä käyttöön.
VITE_APP_PASSWORD=

# Valinnainen: nimikkeiden kuvien lataus suoraan Google Driveen Firebase
# Storagen sijaan (ei vaadi Blaze-laskutusta). Katso README "Google Drive
# kuvien tallennukseen" -osio OAuth-clientin luomiseen.
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_FOLDER_ID=

# Valinnainen, suositeltu: lataus Apps Script -web-sovelluksen kautta, jolloin
# lataajan ei tarvitse kirjautua Googleen (ks. apps-script/upload.gs ja README).
# Kun tämä on asetettu, yllä olevia OAuth-arvoja ei käytetä.
VITE_DRIVE_UPLOAD_URL=
VITE_DRIVE_UPLOAD_SECRET=
