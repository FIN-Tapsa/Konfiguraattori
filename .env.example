# Kopioi tämä tiedosto nimelle .env ja täytä arvot omasta Firebase-projektistasi.
# Firebase-konsoli -> Project settings -> General -> "Your apps" -> Web app -> SDK setup and configuration.
# .env ei ole gitissä (katso .gitignore) - älä committoi omia arvojasi.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Valinnainen: kevyt kiinteä salasanakysely etusivulla (ei oikeaa tietoturvaa,
# ks. src/components/PasswordGate.tsx). Jätä tyhjäksi jos et halua sitä käyttöön.
VITE_APP_PASSWORD=
